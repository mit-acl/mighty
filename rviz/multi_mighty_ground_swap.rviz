Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
      Splitter Ratio: 0.5
    Tree Height: 700
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: false
      Filter (blacklist): ""
      Filter (whitelist): ""
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 1
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: false
    - Class: rviz_common/Group
      Displays:
        - Class: rviz_default_plugins/Marker
          Enabled: true
          Name: NX01 Body
          Namespaces:
            {}
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /NX01/drone_marker
          Value: true
        - Class: rviz_default_plugins/MarkerArray
          Enabled: true
          Name: NX01 Traj
          Namespaces:
            {}
          Topic:
            Depth: 10
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /NX01/traj_committed_colored
          Value: true
        - Class: rviz_default_plugins/MarkerArray
          Enabled: true
          Name: NX01 Actual Trajectory
          Namespaces:
            {}
          Topic:
            Depth: 10
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /NX01/actual_traj
          Value: true
        - Class: rviz_default_plugins/Marker
          Enabled: true
          Name: NX01 Vel Text
          Namespaces:
            {}
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /NX01/vel_text
          Value: true
        - Class: rviz_default_plugins/PointStamped
          Alpha: 1
          Color: 204; 41; 204
          Enabled: true
          History Length: 1
          Name: NX01 Point Term G
          Radius: 0.2
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /NX01/point_G_term
          Value: true
        - Class: rviz_default_plugins/PointCloud2
          Alpha: 0.4
          Autocompute Intensity Bounds: true
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 255; 255
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: false
          Name: NX01 Sensor PCL
          Position Transformer: XYZ
          Size (m): 0.05
          Style: Flat Squares
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /NX01/sensor_point_cloud
          Use Fixed Frame: true
          Value: false
      Enabled: true
      Name: NX01
