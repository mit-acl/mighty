# syntax=docker/dockerfile:1.7-labs
# mighty-hw — the MIGHTY hardware autonomy stack in ONE container, running the
# same attachable 7-pane tmux 'hw_mighty' session inside it (sibling of the
# rover-drive container; see rfc0001 rover_bringup/docker for the pattern).
#
# Sources are BAKED FROM THE HOST CHECKOUTS (build context = /home/swarm/code,
# i.e. ../../../.. from this docker/ dir — the rover-drive trick): what the
# rover runs natively today is exactly what gets containerized, including local
# commits and applied configs (global_mapper z_ground, MID360 host IP). We do
# NOT re-clone from mighty.repos here: those pins lack dlio and mpc entirely,
# and the host workspaces are the operative source of truth for hardware.
#
# In-image workspace paths == host paths (/home/swarm/code/...), so
# run_hw_red_rover.py (hardcoded MIGHTY_WS / DECOMP_SETUP_BASH) runs unmodified.
#
# Single stage on purpose: for this stack runtime deps ≈ build deps (mighty
# links decomp_rviz_plugins -> rviz/ogre libs must be present at runtime
# anyway), so a runtime-only stage saves little; build/ and log/ trees are
# removed in-layer instead. Layer order is chosen for fast rebuilds: apt/pip
# first (stable), then the three dependency workspaces (rarely change), then
# mighty_ws LAST so a mighty/mpc code edit only re-runs the final colcon layer.
#
# Runs as root (rover-drive precedent): nothing host-owned is mounted rw.

FROM ros:humble-ros-base

ENV ROS_DISTRO=humble
ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-c"]

# ---- system + ROS deps -------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        git tmux vim wget gdb \
        python3-pip python3-yaml \
        libpcl-dev libeigen3-dev nlohmann-json3-dev \
        ros-${ROS_DISTRO}-rmw-zenoh-cpp \
        ros-${ROS_DISTRO}-pcl-ros \
        ros-${ROS_DISTRO}-pcl-conversions \
        ros-${ROS_DISTRO}-pcl-msgs \
        ros-${ROS_DISTRO}-gazebo-msgs \
        ros-${ROS_DISTRO}-rviz-common \
        ros-${ROS_DISTRO}-rviz-rendering \
        ros-${ROS_DISTRO}-rviz-default-plugins \
        ros-${ROS_DISTRO}-rviz-ogre-vendor \
        ros-${ROS_DISTRO}-image-transport \
        ros-${ROS_DISTRO}-cv-bridge \
        ros-${ROS_DISTRO}-laser-geometry \
        ros-${ROS_DISTRO}-joy \
        ros-${ROS_DISTRO}-message-filters \
        ros-${ROS_DISTRO}-example-interfaces \
        ros-${ROS_DISTRO}-tf2-eigen \
        ros-${ROS_DISTRO}-tf2-geometry-msgs \
        ros-${ROS_DISTRO}-tf2-sensor-msgs \
        ros-${ROS_DISTRO}-tf-transformations \
        libtbb-dev \
    && rm -rf /var/lib/apt/lists/*

# ---- python deps ---------------------------------------------------------------
RUN pip3 install --no-cache-dir casadi==3.6.7 do-mpc==5.1.1 tmuxp && \
    pip3 install --no-cache-dir numpy==2.2.6 scipy==1.15.3

ENV CODE_DIR=/home/swarm/code
ENV MIGHTY_WS=${CODE_DIR}/mighty_ws
ENV DECOMP_WS=${CODE_DIR}/decomp_ws
ENV LIVOX_WS=${CODE_DIR}/livox_ws
ENV LIVOX_SDK_DIR=${CODE_DIR}/Livox-SDK2

# ---- decomp_ws ----
COPY decomp_ws/src ${DECOMP_WS}/src
WORKDIR ${DECOMP_WS}
RUN source /opt/ros/${ROS_DISTRO}/setup.bash && \
    colcon build --packages-select decomp_util --cmake-args -DCMAKE_BUILD_TYPE=Release && \
    source install/setup.bash && \
    colcon build --cmake-args -DCMAKE_BUILD_TYPE=Release && \
    rm -rf build log

# ---- Livox-SDK2 ----
COPY Livox-SDK2 ${LIVOX_SDK_DIR}
WORKDIR ${LIVOX_SDK_DIR}
RUN rm -rf build && mkdir build && cd build && \
    cmake .. && make -j$(nproc) && make install && \
    cd .. && rm -rf build

# ---- livox_ros_driver2 (PREBUILT — baked from the host install) ----
COPY livox_ws/install ${LIVOX_WS}/install

# ---- mighty_ws ----
WORKDIR ${MIGHTY_WS}

# ---- dynus_interfaces ----
COPY mighty_ws/src/dynus_interfaces ${MIGHTY_WS}/src/dynus_interfaces
RUN source /opt/ros/${ROS_DISTRO}/setup.bash && \
    colcon build \
        --packages-select dynus_interfaces \
        --cmake-args -DCMAKE_BUILD_TYPE=Release && \
    rm -rf build log

# ---- mpc ----
COPY --exclude=config \
    mighty_ws/src/mpc ${MIGHTY_WS}/src/mpc
RUN source /opt/ros/${ROS_DISTRO}/setup.bash && \
    source ${DECOMP_WS}/install/setup.bash && \
    export CMAKE_PREFIX_PATH=${LIVOX_WS}/install/livox_ros_driver2:${CMAKE_PREFIX_PATH} && \
    colcon build \
        --packages-select mpc \
        --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_SIMULATION=OFF && \
    rm -rf build log

# ---- mighty ----
COPY --exclude=config \
     --exclude=launch \
     --exclude=rviz \
     --exclude=scripts/run_hw_red_rover.py \
     mighty_ws/src/mighty ${MIGHTY_WS}/src/mighty
# Empty placeholders for the excluded runtime dirs: mighty CMake's
# `install(DIRECTORY launch config rviz ...)` ERRORS on a missing source dir
# (it does not silently skip), so create them empty here; the overlay COPYs at
# the bottom fill the installed share tree with the real files. (mpc needs no
# placeholder: it is ament_python and glob("config/*.yaml") just returns [].)
RUN mkdir -p ${MIGHTY_WS}/src/mighty/config \
             ${MIGHTY_WS}/src/mighty/launch \
             ${MIGHTY_WS}/src/mighty/rviz && \
    source /opt/ros/${ROS_DISTRO}/setup.bash && \
    source ${DECOMP_WS}/install/setup.bash && \
    source ${MIGHTY_WS}/install/setup.bash && \
    export CMAKE_PREFIX_PATH=${LIVOX_WS}/install/livox_ros_driver2:${CMAKE_PREFIX_PATH} && \
    colcon build \
        --packages-select mpc mighty \
        --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_SIMULATION=OFF && \
    rm -rf build log

# ---- direct_lidar_inertial_odometry ----
COPY mighty_ws/src/direct_lidar_inertial_odometry ${MIGHTY_WS}/src/direct_lidar_inertial_odometry
RUN source /opt/ros/${ROS_DISTRO}/setup.bash && \
    source ${DECOMP_WS}/install/setup.bash && \
    export CMAKE_PREFIX_PATH=${LIVOX_WS}/install/livox_ros_driver2:${CMAKE_PREFIX_PATH} && \
    colcon build \
        --packages-up-to direct_lidar_inertial_odometry \
        --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_SIMULATION=OFF && \
    rm -rf build log

# ---- acl_mapping ----
COPY --exclude=global_mapper_ros/cfg \
    mighty_ws/src/acl-mapping ${MIGHTY_WS}/src/acl-mapping
RUN mkdir -p ${MIGHTY_WS}/src/acl-mapping/global_mapper_ros/cfg && \
    source /opt/ros/${ROS_DISTRO}/setup.bash && \
    source ${DECOMP_WS}/install/setup.bash && \
    source ${MIGHTY_WS}/install/setup.bash && \
    colcon build \
        --packages-select fla_interfaces fla_utils global_mapper global_mapper_ros \
        --cmake-args -DCMAKE_BUILD_TYPE=Release -DUSE_SYSTEM_EIGEN3=ON && \
    rm -rf build log

# # Empty placeholders for the excluded runtime dirs: mighty's CMake
# # `install(DIRECTORY launch config rviz ...)` ERRORS on a missing source dir
# # (it doesn't silently skip), so create them empty here — colcon then installs
# # empty config/launch/rviz into share/mighty, and the overlay COPYs at the
# # bottom fill them with the real files. (mkdir doesn't depend on their content,
# # so this layer stays cached across YAML edits.)
# RUN mkdir -p ${MIGHTY_WS}/src/mighty/config ${MIGHTY_WS}/src/mighty/launch \
#              ${MIGHTY_WS}/src/mighty/rviz   ${MIGHTY_WS}/src/mpc/config && \
#     source /opt/ros/${ROS_DISTRO}/setup.bash && \
#     source ${DECOMP_WS}/install/setup.bash && \
#     export CMAKE_PREFIX_PATH=${LIVOX_WS}/install/livox_ros_driver2:${CMAKE_PREFIX_PATH} && \
#     colcon build \
#         --packages-up-to mighty mpc direct_lidar_inertial_odometry local_sensing \
#         --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_SIMULATION=OFF && \
#     rm -rf build log



# ---- mighty_ws, part 2 (FAST layer: the leaf packages we iterate on) ------------
# global_mapper / global_mapper_ros (+ fla_interfaces, fla_utils,
# which only global_mapper_ros uses). Editing any of them re-runs ONLY this
# layer; part 1's install tree above stays cached.
#
# Two COPY lines, not one: `COPY dirA dirB dest/` merges the CONTENTS of both
# into dest instead of preserving the directory names.
#
# --packages-SELECT (not up-to): part 1 removed build/, so `up-to` would drag
# dynus_interfaces into a rebuild here; `select` takes it from the sourced
# install space instead. colcon still topo-orders the selected set, so
# global_mapper builds before global_mapper_ros. USE_SYSTEM_EIGEN3=ON keeps
# on the apt libeigen3-dev instead of FetchContent-ing Eigen.
#
# global_mapper_ros/cfg is excluded + placeholder-mkdir'd for the same reason as
# mighty's config/launch/rviz above (its CMakeLists install(DIRECTORY cfg)
# errors on a missing dir); the real cfg is overlaid at the bottom of this file.

# COPY --exclude=global_mapper_ros/cfg mighty_ws/src/acl-mapping ${MIGHTY_WS}/src/acl-mapping
# RUN mkdir -p ${MIGHTY_WS}/src/acl-mapping/global_mapper_ros/cfg && \
#     source /opt/ros/${ROS_DISTRO}/setup.bash && \
#     source ${DECOMP_WS}/install/setup.bash && \
#     source ${MIGHTY_WS}/install/setup.bash && \
#     colcon build \
#         --packages-select fla_interfaces fla_utils global_mapper global_mapper_ros \
#         --cmake-args -DCMAKE_BUILD_TYPE=Release -DUSE_SYSTEM_EIGEN3=ON && \
#     rm -rf build log

ENV LD_LIBRARY_PATH=${LIVOX_WS}/install/livox_ros_driver2/lib:/usr/local/lib

# tmux panes are interactive bash shells: mirror the host ~/.bashrc sourcing so
# every pane resolves all three workspaces. The livox pane in particular finds
# livox_ros_driver2 only through here, exactly as on the native rover.
#
# HISTCONTROL: modern tmuxp (suppress_history default) prepends a space to the
# commands it sends, and stock 'ignorespace' would keep them OUT of bash
# history — breaking the Ctrl-C / Up / Enter pane-restart workflow (same gotcha
# the drive stack fixed via suppress_history:false in drive_tmux.yaml; our YAML
# is generated by run_hw_red_rover.py, so fix it shell-side instead).
RUN sed -i 's/^HISTCONTROL=.*/HISTCONTROL=ignoredups/' /root/.bashrc && \
    echo 'source /opt/ros/humble/setup.bash'                    >> /root/.bashrc && \
    echo "source ${DECOMP_WS}/install/setup.bash"               >> /root/.bashrc && \
    echo "source ${LIVOX_WS}/install/setup.bash"                >> /root/.bashrc && \
    echo "source ${MIGHTY_WS}/install/setup.bash"               >> /root/.bashrc && \
    echo "export LD_LIBRARY_PATH=${LIVOX_WS}/install/livox_ros_driver2/lib:/usr/local/lib:\${LD_LIBRARY_PATH}" >> /root/.bashrc

WORKDIR ${MIGHTY_WS}
# Command comes from compose (inline launcher; see compose.hw.yaml).

# ---- runtime overlay (LAST layers) ---------------------------------------------
# The tunable dirs excluded from the mighty_ws COPY above are placed straight into
# the installed share trees here, AFTER the compile. Editing any of these re-runs
# ONLY these trivial copies — the colcon layer stays cached. Two independent share
# trees: share/mighty (CMake install(DIRECTORY)) and share/mpc (ament_python).
COPY mighty_ws/src/mighty/config ${MIGHTY_WS}/install/mighty/share/mighty/config
COPY mighty_ws/src/mighty/launch ${MIGHTY_WS}/install/mighty/share/mighty/launch
COPY mighty_ws/src/mighty/rviz   ${MIGHTY_WS}/install/mighty/share/mighty/rviz
COPY mighty_ws/src/mpc/config    ${MIGHTY_WS}/install/mpc/share/mpc/config
COPY mighty_ws/src/acl-mapping/global_mapper_ros/cfg ${MIGHTY_WS}/install/global_mapper_ros/share/global_mapper_ros/cfg
# The tmux launcher is run by compose STRAIGHT FROM THE SOURCE TREE
# (`python3 src/mighty/scripts/run_hw_red_rover.py`, see compose.hw.yaml) and is
# neither compiled nor installed — mighty's CMake install(PROGRAMS ...) lists 8
# other scripts but NOT this one. So it goes back into src/ here instead of into
# a share/ tree, and editing it costs one tiny COPY layer, not a recompile.
COPY mighty_ws/src/mighty/scripts/run_hw_red_rover.py ${MIGHTY_WS}/src/mighty/scripts/run_hw_red_rover.py
